# Public metadata and contact values. Replace every example before release.
VITE_SITE_ORIGIN=https://www.example.com
VITE_CONTACT_EMAIL=hello@example.com
VITE_COMPANY_LEGAL_NAME=Example Legal Company Name
VITE_COMPANY_ADDRESS=Example registered business address
VITE_COMPANY_COUNTRY_CODE=US
VITE_PRIVACY_POLICY_URL=https://www.example.com/privacy
VITE_TERMS_URL=https://www.example.com/terms

# Optional public destinations. Leave blank to suppress their CTAs.
VITE_DEMO_BOOKING_URL=
VITE_APPROVED_DEMO_URL=

# Indexing is enabled only when both client and runtime settings explicitly agree.
VITE_DEPLOYMENT_ENV=preview
VITE_ALLOW_INDEXING=false
PUBLIC_SITE_ORIGIN=https://www.example.com
DEPLOYMENT_ENV=preview
ALLOW_INDEXING=false

# Comma-separated, exact origins only. Empty defaults framing to none.
FRAME_ANCESTORS=
LEAD_ALLOWED_ORIGINS=https://www.example.com

# Lead data is not sent to arbitrary webhooks. Production remains blocked until
# an approved first-party lead-system binding is implemented and reviewed.
# LEAD_WEBHOOK_URL=
# LEAD_WEBHOOK_TOKEN=
